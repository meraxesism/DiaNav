/* Small Mobile Devices */
@media (max-width: 480px) {
  .dianav-quick-actions-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 16px;
  }
  
  .dianav-quick-action-btn {
    min-height: 70px;
    padding: 14px 12px;
  }
  
  .dianav-chat-bubble {
    max-width: 90%;
    padding: 10px 14px;
  }
  
  .dianav-header {
    padding: 12px 16px;
  }
  
  .dianav-title {
    font-size: 1rem;
  }
  
  .dianav-ai-label {
    font-size: 0.8rem;
  }
  
  .dianav-welcome .dianav-h1 {
    font-size: 1.3rem;
  }
  
  .dianav-input-row {
    padding: 12px;
  }
  
  .dianav-input-row input {
    padding: 10px 14px;
    min-height: 44px;
  }
  
  .dianav-input-row button {
    min-width: 44px;
    min-height: 44px;
