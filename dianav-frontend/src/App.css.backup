    margin-bottom: 60px;
  }
}

/* Professional Mobile Responsive Design - ChatGPT/Copilot Style */
/* Desktop experience remains completely unchanged */

/* Mobile Breakpoint - Professional Mobile Layout */
@media (max-width: 768px) {
  /* Full-screen mobile experience */
  .dianav-outer {
    padding: 0;
    background: #15325c;
    width: 100vw;
    max-width: 100vw;
    overflow-x: hidden;
  }
  
  .dianav-root {
    max-width: 100%;
    width: 100%;
    height: 100vh;
    border-radius: 0;
    box-shadow: none;
    overflow-x: hidden;
  }
  
  .dianav-app-wide {
    height: 100vh;
    width: 100%;
    overflow-x: hidden;
    max-width: 100vw;
  }
  
  /* Mobile Header - Adaptive and Touch-Friendly */
  .dianav-header {
    padding: clamp(12px, 3vw, 16px) clamp(16px, 4vw, 20px) !important;
    border-radius: 0 !important;
    position: sticky !important;
    top: 0 !important;
    z-index: 100 !important;
    background: #10294b !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1) !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  
  .dianav-title {
    font-size: clamp(1rem, 3vw, 1.1rem) !important;
    margin-left: 0 !important;
