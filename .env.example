# DiaNav Environment Configuration
# Copy this file to .env and update the values for your environment

# Backend Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000
FRONTEND_PORT=3000

# API Keys (Optional - only needed if using OpenAI vector search)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b

# Data Configuration
USE_SAMPLE_DATA=false
PDF_PATH=SZM_ DTC_Troubleshooting_Guide_V1.4_main_v2.pdf
TXT_PATH=SZM_ DTC_Troubleshooting_Guide_V1.4_main_v2.txt
JSON_PATH=SZM_ DTC_Troubleshooting_Guide_V1.4_main_v2.json
SAMPLE_PATH=sample_dtc_data.txt

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Vector Search Configuration
VECTOR_SEARCH_TYPE=local  # Options: local, openai
EMBEDDINGS_FILE=local_dtc_embeddings.json

# Logging Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
